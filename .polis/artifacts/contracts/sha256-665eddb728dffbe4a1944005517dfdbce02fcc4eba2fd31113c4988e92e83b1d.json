  "development_method": "strict_sdd_tdd_v2",
  "specification": {
    "objective": "Implement a combinable, non-mutating pending queue filter UI without changing whole-queue bulk decision scope.",
    "requirements": [
      {
        "id": "REQ-1",
        "statement": "Filter pending records by search, action, target, origin, target status, and inclusive UTC date range with an explicit clear-all control."
      },
      {
        "id": "REQ-2",
        "statement": "Show global and filtered totals, keep queue navigation usable on zero matches, and treat invalid timestamps as unknown."
      },
      {
        "id": "REQ-3",
        "statement": "All approval and rejection actions remain explicitly whole-queue, even if filters hide some records."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-1",
        "statement": "Executable UI logic tests demonstrate intersection of all filters, stable unmodified inputs, inclusive dates, invalid dates and reset behavior.",
        "requirements": [
          "REQ-1",
          "REQ-2"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-2",
        "statement": "Source UI contract tests show clear filters, visible filtered count, controls on zero matches, and whole-queue bulk action confirmation.",
        "requirements": [
          "REQ-2",
          "REQ-3"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-1",
        "statement": "Filtering is read-only and never changes pending records nor the selector sent for approve/reject all."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORBID-1",
        "statement": "Filtering silently limits bulk decisions or hides all filter controls when no matches exist."
      }
    ],
    "inputs": [
      {
        "id": "IN-1",
        "statement": "Existing GET /records action target origin created_at and target_status fields."
      }
    ],
    "outputs": [
      {
        "id": "OUT-1",
        "statement": "Deterministically filtered view and clear whole-queue bulk scope."
      }
    ],
    "failure_semantics": [
      {
        "id": "FAIL-1",
        "statement": "Invalid timestamp renders Unknown and cannot satisfy selected date bounds."
      }
    ]
  },
