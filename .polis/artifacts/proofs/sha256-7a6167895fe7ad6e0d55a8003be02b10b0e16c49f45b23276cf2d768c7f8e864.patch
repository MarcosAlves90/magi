+"""MAGI-019 frontend wait abandonment and late response fences."""
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_magi_019_old_async_result_never_matches_new_request():
+    source = (ROOT / 'desktop/plugin.js').read_text()
+    assert 'function isActiveCompactionRequest(' in source
+    script = """
+const fs=require('fs'),vm=require('vm'),src=fs.readFileSync('desktop/plugin.js','utf8');
+const start=src.indexOf('function isActiveCompactionRequest('),end=src.indexOf('const CONTROL_TRANSITION',start);
+const active=vm.runInNewContext(src.slice(start,end)+'\\nisActiveCompactionRequest');
+const started=1,afterAbandon=2,newRequest=3;
+console.log(JSON.stringify([active(started,started),active(started,afterAbandon),active(started,newRequest),active(newRequest,newRequest)]));
+"""
+    response = subprocess.run(['node', '-e', script], cwd=ROOT, capture_output=True, text=True, check=True)
+    assert json.loads(response.stdout) == [True, False, False, True]
+
+
+def test_magi_019_failure_types_are_actionable():
+    source = (ROOT / 'desktop/plugin.js').read_text()
+    assert 'function classifyCompactionFailure(' in source
+    script = """
+const fs=require('fs'),vm=require('vm'),src=fs.readFileSync('desktop/plugin.js','utf8');
+const start=src.indexOf('function isActiveCompactionRequest('),end=src.indexOf('const CONTROL_TRANSITION',start);
+const classify=vm.runInNewContext(src.slice(start,end)+'\\nclassifyCompactionFailure');
+console.log(JSON.stringify([classify(new Error('Request timed out')),classify(new Error('Failed to fetch')),
+classify({kind:'validation',message:'Invalid compaction entries'})]));
+"""
+    response = subprocess.run(['node','-e',script],cwd=ROOT,capture_output=True,text=True,check=True)
+    timeout, network, validation = json.loads(response.stdout)
+    assert 'timed out' in timeout.lower()
+    assert 'network' in network.lower()
+    assert 'validation' in validation.lower()
+
+
+def test_magi_019_ui_fences_late_success_and_errors_without_false_cancellation_claims():
+    source = (ROOT / 'desktop/plugin.js').read_text()
+    stored = source.split('function StoredMemoryPage', 1)[1].split('function MagiPage', 1)[0]
+    assert 'compactionRequestId.current += 1' in stored
+    assert 'isActiveCompactionRequest(requestId, compactionRequestId.current)' in stored
+    assert 'Stop waiting' in stored
+    assert 'This stops waiting in Desktop' in stored
+    assert 'may continue in Hermes' in stored
+    assert 'Request sent to Hermes' in stored
+    assert 'No progress percentage is available' in stored
+    assert 'classifyCompactionFailure(error)' in stored
+    assert 'disabled: saving || applyingCompaction ||' in stored
+    assert 'disabled: applyingCompaction' in stored
